doctype html

tg-project-archived-warning
div.wrapper.gantt(
    ng-init="section='gantt'; sectionName='PROJECT.SECTION.GANTT'"
    ng-controller="GanttController as ctrl"
)
    tg-project-menu

    section.main.gantt-main(role="main")
        .gantt-top
            include ../includes/components/mainTitle

        p(ng-if="ctrl.loading") Loading gantt...
        p(ng-if="ctrl.loadingError") Unable to load gantt data.

        .gantt-workspace(
            tg-gantt-sync-rows
            tg-gantt-panel-resize
            tg-gantt-tree-reorder
            tg-gantt-bar-resize
            ng-class="{'is-linking-gantt-bars': ctrl.barLinkModeActive, 'is-bar-editing-unlocked': !ctrl.barsLocked && ctrl.canReorderGanttRows()}"
            ng-if="!ctrl.loading && !ctrl.loadingError"
        )
            .gantt-toolbar
                .gantt-toolbar-inner
                    .gantt-toolbar-history
                        button.gantt-toolbar-history-button(
                            type="button"
                            ng-click="ctrl.undoBarChange($event)"
                            ng-mousedown="ctrl.stopToolbarMenuEvent($event)"
                            ng-disabled="!ctrl.canUndoBarChange()"
                            aria-label="Undo changes"
                            title="Undo changes"
                        )
                            svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-back-up")
                                path(stroke="none" d="M0 0h24v24H0z" fill="none")
                                path(d="M9 14l-4 -4l4 -4")
                                path(d="M5 10h11a4 4 0 1 1 0 8h-1")
                        button.gantt-toolbar-history-button(
                            type="button"
                            ng-click="ctrl.redoBarChange($event)"
                            ng-mousedown="ctrl.stopToolbarMenuEvent($event)"
                            ng-disabled="!ctrl.canRedoBarChange()"
                            aria-label="Redo changes"
                            title="Redo changes"
                        )
                            svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-forward-up")
                                path(stroke="none" d="M0 0h24v24H0z" fill="none")
                                path(d="M15 14l4 -4l-4 -4")
                                path(d="M19 10h-11a4 4 0 1 0 0 8h1")
                    .gantt-toolbar-color-picker
                        button.gantt-toolbar-color-picker-button(
                            type="button"
                            ng-class="{'is-active': ctrl.colorPickerModeActive}"
                            ng-click="ctrl.toggleColorPickerMode($event)"
                            ng-mousedown="ctrl.stopToolbarMenuEvent($event)"
                            ng-disabled="!ctrl.canUseColorPickerMode()"
                            ng-attr-aria-label="{{ctrl.colorPickerModeActive ? 'Disable color picker mode' : 'Enable color picker mode'}}"
                            ng-attr-title="{{ctrl.colorPickerModeActive ? 'Disable color picker mode' : 'Enable color picker mode'}}"
                        )
                            svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-color-picker")
                                path(stroke="none" d="M0 0h24v24H0z" fill="none")
                                path(d="M11 7l6 6")
                                path(d="M4 16l11.7 -11.7a1 1 0 0 1 1.4 0l2.6 2.6a1 1 0 0 1 0 1.4l-11.7 11.7h-4v-4")
                    .gantt-toolbar-link
                        button.gantt-toolbar-link-button(
                            type="button"
                            ng-class="{'is-active': ctrl.barLinkModeActive}"
                            ng-click="ctrl.toggleBarLinkMode($event)"
                            ng-mousedown="ctrl.stopToolbarMenuEvent($event)"
                            ng-disabled="!ctrl.canUseBarLinkMode()"
                            ng-attr-aria-label="{{'PROJECT.GANTT.LINK_MODE' | translate}}"
                            ng-attr-title="{{'PROJECT.GANTT.LINK_MODE' | translate}}"
                        )
                            svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-arrow-guide")
                                path(stroke="none" d="M0 0h24v24H0z" fill="none")
                                path(d="M18.707 3.293l3 3q .054 .053 .097 .112l.071 .11l.054 .114l.035 .105l.03 .148l.006 .118l-.003 .075l-.017 .126l-.03 .111l-.044 .111l-.052 .098l-.067 .096l-.08 .09l-3 3a1 1 0 0 1 -1.414 -1.414l1.292 -1.293h-4.585a1 1 0 0 0 -1 1v8a3 3 0 0 1 -3 3h-2.171a3.001 3.001 0 0 1 -5.829 -1l.005 -.176a3 3 0 0 1 5.825 -.824h2.17a1 1 0 0 0 1 -1v-8a3 3 0 0 1 3 -3h4.585l-1.292 -1.293a1 1 0 0 1 -.083 -1.32l.083 -.094a1 1 0 0 1 1.414 0")
                    .gantt-toolbar-critical-path
                        button.gantt-toolbar-critical-path-button(
                            type="button"
                            ng-class="{'is-active': ctrl.criticalPathHighlightActive}"
                            ng-click="ctrl.toggleCriticalPathHighlight($event)"
                            ng-mousedown="ctrl.stopToolbarMenuEvent($event)"
                            ng-disabled="!ctrl.hasCriticalPath()"
                            aria-label="Show critical path"
                            title="Show critical path"
                        )
                            svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16")
                                path(fill="currentColor" fill-rule="evenodd" d="M2 4a2 2 0 1 1 2.5 1.937V11.5a1.5 1.5 0 0 0 3 0v-7a2.5 2.5 0 0 1 5 0v3h-1v-3a1.5 1.5 0 0 0 -3 0v7a2.5 2.5 0 0 1 -5 0V5.937A2 2 0 0 1 2 4m8 6.5a2 2 0 1 1 4 0a3.67 3.67 0 0 1 -1.565 3.006L12 13.81l-.435 -.304A3.67 3.67 0 0 1 10 10.5" clip-rule="evenodd")
                    .gantt-toolbar-zoom(ng-class="{'is-open': ctrl.zoomMenuOpen}")
                        button.gantt-toolbar-zoom-button(
                            type="button"
                            ng-click="ctrl.toggleZoomMenu($event)"
                            ng-mousedown="ctrl.stopToolbarMenuEvent($event)"
                            ng-attr-aria-label="{{'PROJECT.GANTT.ZOOM_OPTIONS' | translate}}"
                            ng-attr-title="{{'PROJECT.GANTT.ZOOM_OPTIONS' | translate}}"
                        )
                            svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-autofit-content")
                                path(stroke="none" d="M0 0h24v24H0z" fill="none")
                                path(d="M6 4l-3 3l3 3")
                                path(d="M18 4l3 3l-3 3")
                                path(d="M4 16a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v2a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2l0 -2")
                                path(d="M10 7h-7")
                                path(d="M21 7h-7")
                        .gantt-toolbar-zoom-menu(
                            ng-if="ctrl.zoomMenuOpen"
                            ng-click="ctrl.stopToolbarMenuEvent($event)"
                            ng-mousedown="ctrl.stopToolbarMenuEvent($event)"
                        )
                            label.gantt-toolbar-zoom-option
                                input(
                                    type="checkbox"
                                    ng-checked="ctrl.selectedZoomOption == 'daily'"
                                    ng-click="ctrl.selectZoomOption('daily', $event)"
                                )
                                span(translate="PROJECT.GANTT.ZOOM.DAILY")
                            label.gantt-toolbar-zoom-option
                                input(
                                    type="checkbox"
                                    ng-checked="ctrl.selectedZoomOption == 'weekly'"
                                    ng-click="ctrl.selectZoomOption('weekly', $event)"
                                )
                                span(translate="PROJECT.GANTT.ZOOM.WEEKLY")
                            label.gantt-toolbar-zoom-option
                                input(
                                    type="checkbox"
                                    ng-checked="ctrl.selectedZoomOption == 'monthly'"
                                    ng-click="ctrl.selectZoomOption('monthly', $event)"
                                )
                                span(translate="PROJECT.GANTT.ZOOM.MONTHLY")
                            .gantt-toolbar-zoom-slider(
                                ng-class="{'is-disabled': ctrl.isTimelineWidthSliderDisabled()}"
                                ng-click="ctrl.stopToolbarMenuEvent($event)"
                                ng-mousedown="ctrl.stopToolbarMenuEvent($event)"
                            )
                                span.gantt-toolbar-zoom-slider-sign(
                                    ng-attr-aria-hidden="true"
                                )
                                    svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-zoom-out")
                                        path(stroke="none" d="M0 0h24v24H0z" fill="none")
                                        path(d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0")
                                        path(d="M7 10l6 0")
                                        path(d="M21 21l-6 -6")
                                input.gantt-toolbar-zoom-slider-input(
                                    type="range"
                                    ng-model="ctrl.timelineWidthSliderValue"
                                    ng-change="ctrl.onTimelineWidthSliderInput()"
                                    ng-disabled="ctrl.isTimelineWidthSliderDisabled()"
                                    ng-attr-min="{{ctrl.timelineWidthSliderMin}}"
                                    ng-attr-max="{{ctrl.timelineWidthSliderMax}}"
                                    ng-attr-step="{{ctrl.timelineWidthSliderStep}}"
                                )
                                span.gantt-toolbar-zoom-slider-sign(
                                    ng-attr-aria-hidden="true"
                                )
                                    svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-zoom-in")
                                        path(stroke="none" d="M0 0h24v24H0z" fill="none")
                                        path(d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0")
                                        path(d="M7 10l6 0")
                                        path(d="M10 7l0 6")
                                        path(d="M21 21l-6 -6")
                    .gantt-toolbar-lock
                        button.gantt-toolbar-lock-button(
                            type="button"
                            ng-class="{'is-unlocked': !ctrl.barsLocked}"
                            ng-click="ctrl.toggleBarsLock($event)"
                            ng-mousedown="ctrl.stopToolbarMenuEvent($event)"
                            ng-disabled="!ctrl.canToggleBarsLock()"
                            ng-attr-aria-label="{{ctrl.barsLocked ? 'Unlock bar editing' : 'Lock bar editing'}}"
                            ng-attr-title="{{ctrl.barsLocked ? 'Unlock bar editing' : 'Lock bar editing'}}"
                        )
                            svg(
                                ng-if="ctrl.barsLocked"
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="icon icon-tabler icons-tabler-outline icon-tabler-lock"
                            )
                                path(stroke="none" d="M0 0h24v24H0z" fill="none")
                                path(d="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-6")
                                path(d="M11 16a1 1 0 1 0 2 0a1 1 0 0 0 -2 0")
                                path(d="M8 11v-4a4 4 0 1 1 8 0v4")
                            svg(
                                ng-if="!ctrl.barsLocked"
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="icon icon-tabler icons-tabler-outline icon-tabler-lock-open"
                            )
                                path(stroke="none" d="M0 0h24v24H0z" fill="none")
                                path(d="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2l0 -6")
                                path(d="M11 16a1 1 0 1 0 2 0a1 1 0 1 0 -2 0")
                                path(d="M8 11v-5a4 4 0 0 1 8 0")

            .gantt-panels
                aside.gantt-left-panel(tg-gantt-column-resize)
                    .gantt-table-month-spacer
                    .gantt-table-header
                        span.gantt-col-title.gantt-col-header
                            span.gantt-col-header-text Item
                            button.gantt-col-resizer(
                                type="button"
                                data-gantt-resize="item"
                                aria-label="Resize item column"
                            )
                        span.gantt-col-assignee.gantt-col-header
                            span.gantt-col-header-text Assignee
                            button.gantt-col-resizer(
                                type="button"
                                data-gantt-resize="assignee"
                                aria-label="Resize assignee column"
                            )
                        span.gantt-col-start.gantt-col-header
                            span.gantt-col-header-text Start
                            button.gantt-col-resizer(
                                type="button"
                                data-gantt-resize="start"
                                aria-label="Resize start column"
                            )
                        span.gantt-col-due.gantt-col-header
                            span.gantt-col-header-text Due
                            button.gantt-col-resizer(
                                type="button"
                                data-gantt-resize="due"
                                aria-label="Resize due column"
                            )
                        span.gantt-col-progress.gantt-col-header
                            span.gantt-col-header-text %

                    .gantt-tree
                        .gantt-tree-node(
                            ng-repeat="node in ctrl.tree track by node.rowId"
                            ng-class="{'gantt-node-epic': node.type == 'epic', 'gantt-node-story': node.type == 'story'}"
                            ng-switch="node.type"
                        )
                            div(ng-switch-when="epic")
                                input.gantt-node-trigger(
                                    ng-if="node.children.length"
                                    type="checkbox"
                                    ng-attr-id="{{node.inputId}}"
                                    checked="checked"
                                )
                                label.gantt-tree-row.gantt-row.gantt-row-epic(
                                    ng-class="{'is-collapsible': node.children.length, 'has-color-menu-open': ctrl.isNodeColorMenuOpen(node.rowId), 'color-menu-upward': ctrl.isColorMenuOpenUpward(node.rowId), 'is-critical-path-muted': ctrl.isCriticalPathMuted(node.rowId)}"
                                    ng-attr-for="{{node.children.length ? node.inputId : ('gantt-noop-' + node.rowId)}}"
                                    ng-attr-data-gantt-row-id="{{node.rowId}}"
                                )
                                    span.gantt-col-title(ng-attr-title="{{node.item.subject || node.item.name || '-'}}")
                                        span.gantt-tree-reorder-handle
                                            span.gantt-tree-reorder-handle-lines
                                        span.gantt-row-content
                                            span.gantt-row-toggle
                                                tg-svg.gantt-chevron(ng-if="node.children.length" svg-icon="icon-arrow-down")
                                            span.gantt-row-type-icon(ng-style="node.barColor ? {'color': node.barColor} : null")
                                                button.gantt-row-type-button(
                                                    type="button"
                                                    ng-class="{'is-open': ctrl.isNodeColorMenuOpen(node.rowId)}"
                                                    ng-disabled="!ctrl.colorPickerModeActive || !ctrl.canEditNodeColor(node)"
                                                    ng-mousedown="ctrl.stopColorMenuEvent($event)"
                                                    ng-click="ctrl.toggleNodeColorMenu($event, node)"
                                                    aria-label="Choose color"
                                                    title="Choose color"
                                                )
                                                    svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor")
                                                        path(stroke="none" fill="none" d="M0 0h24v24H0z")
                                                        path(d="M6.18 10.95l2.54 3.175l.084 .093a1 1 0 0 0 1.403 -.01l1.637 -1.638l1.324 1.985a1 1 0 0 0 1.457 .226l3.632 -2.906l3.647 7.697a1 1 0 0 1 -.904 1.428h-18a1 1 0 0 1 -.904 -1.428zm5.82 -7.878a3.3 3.3 0 0 1 2.983 1.888l2.394 5.057l-3.15 2.52l-1.395 -2.092l-.075 -.099a1 1 0 0 0 -1.464 -.053l-1.711 1.709l-1.301 -1.627l-1.151 -1.435l1.888 -3.98a3.3 3.3 0 0 1 2.982 -1.888")
                                                .color-selector-dropdown.gantt-row-color-dropdown(
                                                    ng-if="ctrl.isNodeColorMenuOpen(node.rowId)"
                                                    ng-mousedown="ctrl.stopColorMenuEvent($event)"
                                                    ng-click="ctrl.stopColorMenuEvent($event)"
                                                )
                                                    ul.color-selector-dropdown-list.e2e-color-dropdown
                                                        li.color-selector-option(
                                                            ng-repeat="color in ctrl.colorList track by color"
                                                            ng-style="{'background': color}"
                                                            ng-title="color"
                                                            ng-mousedown="ctrl.stopColorMenuEvent($event)"
                                                            ng-click="ctrl.selectNodeColor($event, node, color)"
                                                        )
                                                    .custom-color-selector
                                                        .display-custom-color.empty-color(ng-if="!ctrl.nodeCustomColorByRowId[node.rowId]")
                                                        .display-custom-color-wrapper
                                                            .display-custom-color(
                                                                ng-if="ctrl.nodeCustomColorByRowId[node.rowId]"
                                                                ng-style="{'background': ctrl.nodeCustomColorByRowId[node.rowId]}"
                                                                ng-mousedown="ctrl.stopColorMenuEvent($event)"
                                                                ng-click="ctrl.selectNodeColor($event, node, ctrl.nodeCustomColorByRowId[node.rowId])"
                                                            )
                                                        input.custom-color-input(
                                                            type="text"
                                                            maxlength="32"
                                                            placeholder="Type color (#hex, rgb, name)"
                                                            ng-model="ctrl.nodeCustomColorByRowId[node.rowId]"
                                                            ng-keydown="ctrl.onNodeColorInputKeyDown($event, node)"
                                                            ng-blur="ctrl.onNodeColorInputBlur(node)"
                                                            ng-click="ctrl.stopColorMenuEvent($event)"
                                                        )
                                            span.gantt-row-label {{ node.item.subject || node.item.name || "-" }}
                                    span.gantt-col-assignee {{ node.assigneeLabel }}
                                    span.gantt-col-start {{ node.startLabel }}
                                    span.gantt-col-due {{ node.dueLabel }}
                                    span.gantt-col-progress
                                        span.gantt-progress-chip {{ node.progressLabel }}

                                .gantt-tree-children(ng-if="node.children.length")
                                    .gantt-tree-node.gantt-node-story(ng-repeat="story in node.children track by story.rowId")
                                        input.gantt-node-trigger(
                                            ng-if="story.children.length"
                                            type="checkbox"
                                            ng-attr-id="{{story.inputId}}"
                                            checked="checked"
                                        )
                                        label.gantt-tree-row.gantt-row.gantt-row-story(
                                            ng-class="{'is-collapsible': story.children.length, 'has-color-menu-open': ctrl.isNodeColorMenuOpen(story.rowId), 'color-menu-upward': ctrl.isColorMenuOpenUpward(story.rowId), 'is-critical-path-muted': ctrl.isCriticalPathMuted(story.rowId)}"
                                            ng-attr-for="{{story.children.length ? story.inputId : ('gantt-noop-' + story.rowId)}}"
                                            ng-attr-data-gantt-row-id="{{story.rowId}}"
                                        )
                                            span.gantt-col-title(ng-attr-title="{{story.item.subject || story.item.name || '-'}}")
                                                span.gantt-tree-reorder-handle
                                                    span.gantt-tree-reorder-handle-lines
                                                span.gantt-row-content
                                                    span.gantt-row-toggle
                                                        tg-svg.gantt-chevron(ng-if="story.children.length" svg-icon="icon-arrow-down")
                                                    span.gantt-row-type-icon(ng-style="story.barColor ? {'color': story.barColor} : null")
                                                        button.gantt-row-type-button(
                                                            type="button"
                                                            ng-class="{'is-open': ctrl.isNodeColorMenuOpen(story.rowId)}"
                                                            ng-disabled="!ctrl.colorPickerModeActive || !ctrl.canEditNodeColor(story)"
                                                            ng-mousedown="ctrl.stopColorMenuEvent($event)"
                                                            ng-click="ctrl.toggleNodeColorMenu($event, story)"
                                                            aria-label="Choose color"
                                                            title="Choose color"
                                                        )
                                                            svg(width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                                                path(d="M15 12h-5")
                                                                path(d="M15 8h-5")
                                                                path(d="M19 17V5a2 2 0 0 0-2-2H4")
                                                                path(d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3")
                                                        .color-selector-dropdown.gantt-row-color-dropdown(
                                                            ng-if="ctrl.isNodeColorMenuOpen(story.rowId)"
                                                            ng-mousedown="ctrl.stopColorMenuEvent($event)"
                                                            ng-click="ctrl.stopColorMenuEvent($event)"
                                                        )
                                                            ul.color-selector-dropdown-list.e2e-color-dropdown
                                                                li.color-selector-option(
                                                                    ng-repeat="color in ctrl.colorList track by color"
                                                                    ng-style="{'background': color}"
                                                                    ng-title="color"
                                                                    ng-mousedown="ctrl.stopColorMenuEvent($event)"
                                                                    ng-click="ctrl.selectNodeColor($event, story, color)"
                                                                )
                                                            .custom-color-selector
                                                                .display-custom-color.empty-color(ng-if="!ctrl.nodeCustomColorByRowId[story.rowId]")
                                                                .display-custom-color-wrapper
                                                                    .display-custom-color(
                                                                        ng-if="ctrl.nodeCustomColorByRowId[story.rowId]"
                                                                        ng-style="{'background': ctrl.nodeCustomColorByRowId[story.rowId]}"
                                                                        ng-mousedown="ctrl.stopColorMenuEvent($event)"
                                                                        ng-click="ctrl.selectNodeColor($event, story, ctrl.nodeCustomColorByRowId[story.rowId])"
                                                                    )
                                                                input.custom-color-input(
                                                                    type="text"
                                                                    maxlength="32"
                                                                    placeholder="Type color (#hex, rgb, name)"
                                                                    ng-model="ctrl.nodeCustomColorByRowId[story.rowId]"
                                                                    ng-keydown="ctrl.onNodeColorInputKeyDown($event, story)"
                                                                    ng-blur="ctrl.onNodeColorInputBlur(story)"
                                                                    ng-click="ctrl.stopColorMenuEvent($event)"
                                                                )
                                                    span.gantt-row-label {{ story.item.subject || story.item.name || "-" }}
                                            span.gantt-col-assignee {{ story.assigneeLabel }}
                                            span.gantt-col-start {{ story.startLabel }}
                                            span.gantt-col-due {{ story.dueLabel }}
                                            span.gantt-col-progress
                                                span.gantt-progress-chip {{ story.progressLabel }}

                                        .gantt-tree-children(ng-if="story.children.length")
                                            .gantt-tree-row.gantt-row.gantt-row-task(
                                                ng-repeat="task in story.children track by task.rowId"
                                                ng-class="{'has-color-menu-open': ctrl.isNodeColorMenuOpen(task.rowId), 'color-menu-upward': ctrl.isColorMenuOpenUpward(task.rowId), 'is-critical-path-muted': ctrl.isCriticalPathMuted(task.rowId)}"
                                                ng-attr-data-gantt-row-id="{{task.rowId}}"
                                            )
                                                span.gantt-col-title(ng-attr-title="{{task.item.subject || task.item.name || '-'}}")
                                                    span.gantt-tree-reorder-handle
