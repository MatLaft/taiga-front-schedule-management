doctype html

tg-project-archived-warning
div.wrapper.gantt(
    ng-init="section='gantt'; sectionName='PROJECT.SECTION.GANTT'"
    ng-controller="GanttController as ctrl"
)
    tg-project-menu

    section.main.gantt-main(role="main")
        .gantt-top
            include ../includes/components/mainTitle

        p(ng-if="ctrl.loading") Loading gantt...
        p(ng-if="ctrl.loadingError") Unable to load gantt data.

        .gantt-workspace(tg-gantt-sync-rows tg-gantt-panel-resize ng-if="!ctrl.loading && !ctrl.loadingError")
            aside.gantt-left-panel(tg-gantt-column-resize)
                .gantt-table-month-spacer
                .gantt-table-header
                    span.gantt-col-title.gantt-col-header
                        span.gantt-col-header-text Item
                        button.gantt-col-resizer(
                            type="button"
                            data-gantt-resize="item"
                            aria-label="Resize item column"
                        )
                    span.gantt-col-assignee.gantt-col-header
                        span.gantt-col-header-text Assignee
                        button.gantt-col-resizer(
                            type="button"
                            data-gantt-resize="assignee"
                            aria-label="Resize assignee column"
                        )
                    span.gantt-col-eh.gantt-col-header
                        span.gantt-col-header-text EH
                        button.gantt-col-resizer(
                            type="button"
                            data-gantt-resize="eh"
                            aria-label="Resize EH column"
                        )
                    span.gantt-col-start.gantt-col-header
                        span.gantt-col-header-text Start
                        button.gantt-col-resizer(
                            type="button"
                            data-gantt-resize="start"
                            aria-label="Resize start column"
                        )
                    span.gantt-col-due.gantt-col-header
                        span.gantt-col-header-text Due
                        button.gantt-col-resizer(
                            type="button"
                            data-gantt-resize="due"
                            aria-label="Resize due column"
                        )
                    span.gantt-col-progress.gantt-col-header
                        span.gantt-col-header-text %

                .gantt-tree
                    .gantt-tree-node(
                        ng-repeat="node in ctrl.tree track by node.rowId"
                        ng-class="{'gantt-node-epic': node.type == 'epic', 'gantt-node-story': node.type == 'story'}"
                        ng-switch="node.type"
                    )
                        div(ng-switch-when="epic")
                            input.gantt-node-trigger(
                                ng-if="node.children.length"
                                type="checkbox"
                                ng-attr-id="{{node.inputId}}"
                                checked="checked"
                            )
                            label.gantt-tree-row.gantt-row.gantt-row-epic(
                                ng-class="{'is-collapsible': node.children.length}"
                                ng-attr-for="{{node.children.length ? node.inputId : undefined}}"
                                ng-attr-data-gantt-row-id="{{node.rowId}}"
                            )
                                span.gantt-col-title(ng-attr-title="{{node.label}}")
                                    span.gantt-row-content
                                        span.gantt-row-toggle
                                            tg-svg.gantt-chevron(ng-if="node.children.length" svg-icon="icon-arrow-down")
                                        span.gantt-row-label {{ node.label }}
                                span.gantt-col-assignee {{ node.assigneeLabel }}
                                span.gantt-col-eh {{ node.ehLabel }}
                                span.gantt-col-start {{ node.startLabel }}
                                span.gantt-col-due {{ node.dueLabel }}
                                span.gantt-col-progress
                                    span.gantt-progress-chip {{ node.progressLabel }}

                            .gantt-tree-children(ng-if="node.children.length")
                                .gantt-tree-node.gantt-node-story(ng-repeat="story in node.children track by story.rowId")
                                    input.gantt-node-trigger(
                                        ng-if="story.children.length"
                                        type="checkbox"
                                        ng-attr-id="{{story.inputId}}"
                                        checked="checked"
                                    )
                                    label.gantt-tree-row.gantt-row.gantt-row-story(
                                        ng-class="{'is-collapsible': story.children.length}"
                                        ng-attr-for="{{story.children.length ? story.inputId : undefined}}"
                                        ng-attr-data-gantt-row-id="{{story.rowId}}"
                                    )
                                        span.gantt-col-title(ng-attr-title="{{story.label}}")
                                            span.gantt-row-content
                                                span.gantt-row-toggle
                                                    tg-svg.gantt-chevron(ng-if="story.children.length" svg-icon="icon-arrow-down")
                                                span.gantt-row-label {{ story.label }}
                                        span.gantt-col-assignee {{ story.assigneeLabel }}
                                        span.gantt-col-eh {{ story.ehLabel }}
                                        span.gantt-col-start {{ story.startLabel }}
                                        span.gantt-col-due {{ story.dueLabel }}
                                        span.gantt-col-progress
                                            span.gantt-progress-chip {{ story.progressLabel }}

                                    .gantt-tree-children(ng-if="story.children.length")
                                        .gantt-tree-row.gantt-row.gantt-row-task(
                                            ng-repeat="task in story.children track by task.rowId"
                                            ng-attr-data-gantt-row-id="{{task.rowId}}"
                                        )
                                            span.gantt-col-title(ng-attr-title="{{task.label}}")
                                                span.gantt-row-content
                                                    span.gantt-row-bullet •
                                                    span.gantt-row-label {{ task.label }}
                                            span.gantt-col-assignee {{ task.assigneeLabel }}
                                            span.gantt-col-eh {{ task.ehLabel }}
                                            span.gantt-col-start {{ task.startLabel }}
                                            span.gantt-col-due {{ task.dueLabel }}
                                            span.gantt-col-progress
                                                span.gantt-progress-chip {{ task.progressLabel }}

                        div(ng-switch-when="story")
                            input.gantt-node-trigger(
                                ng-if="node.children.length"
                                type="checkbox"
                                ng-attr-id="{{node.inputId}}"
                                checked="checked"
                            )
                            label.gantt-tree-row.gantt-row.gantt-row-story.gantt-row-story-root(
                                ng-class="{'is-collapsible': node.children.length}"
                                ng-attr-for="{{node.children.length ? node.inputId : undefined}}"
                                ng-attr-data-gantt-row-id="{{node.rowId}}"
                            )
                                span.gantt-col-title(ng-attr-title="{{node.label}}")
                                    span.gantt-row-content
                                        span.gantt-row-toggle
                                            tg-svg.gantt-chevron(ng-if="node.children.length" svg-icon="icon-arrow-down")
                                        span.gantt-row-label {{ node.label }}
                                span.gantt-col-assignee {{ node.assigneeLabel }}
                                span.gantt-col-eh {{ node.ehLabel }}
                                span.gantt-col-start {{ node.startLabel }}
                                span.gantt-col-due {{ node.dueLabel }}
                                span.gantt-col-progress
                                    span.gantt-progress-chip {{ node.progressLabel }}

                            .gantt-tree-children(ng-if="node.children.length")
                                .gantt-tree-row.gantt-row.gantt-row-task(
                                    ng-repeat="task in node.children track by task.rowId"
                                    ng-attr-data-gantt-row-id="{{task.rowId}}"
                                )
                                    span.gantt-col-title(ng-attr-title="{{task.label}}")
                                        span.gantt-row-content
                                            span.gantt-row-bullet •
                                            span.gantt-row-label {{ task.label }}
                                    span.gantt-col-assignee {{ task.assigneeLabel }}
                                    span.gantt-col-eh {{ task.ehLabel }}
                                    span.gantt-col-start {{ task.startLabel }}
                                    span.gantt-col-due {{ task.dueLabel }}
                                    span.gantt-col-progress
                                        span.gantt-progress-chip {{ task.progressLabel }}

                        .gantt-tree-row.gantt-row.gantt-row-task.gantt-row-task-root(
                            ng-switch-when="task"
                            ng-attr-data-gantt-row-id="{{node.rowId}}"
                        )
                            span.gantt-col-title(ng-attr-title="{{node.label}}")
                                span.gantt-row-content
                                    span.gantt-row-bullet •
                                    span.gantt-row-label {{ node.label }}
                            span.gantt-col-assignee {{ node.assigneeLabel }}
                            span.gantt-col-eh {{ node.ehLabel }}
                            span.gantt-col-start {{ node.startLabel }}
                            span.gantt-col-due {{ node.dueLabel }}
                            span.gantt-col-progress
                                span.gantt-progress-chip {{ node.progressLabel }}

            .gantt-panel-resizer(
                role="separator"
                aria-orientation="vertical"
                aria-label="Resize gantt panels"
                tabindex="0"
            )

            section.gantt-right-panel
                .gantt-timeline
                    .gantt-timeline-months
                        .gantt-month(
                            ng-repeat="month in ctrl.timeline.months track by month.key"
                            ng-style="{'width': (month.widthRem + 'rem')}"
                        ) {{ month.label }}

                    .gantt-timeline-days(
                        ng-style="ctrl.timeline.dayColumnsStyle"
                    )
                        .gantt-day(
                            ng-repeat="day in ctrl.timeline.days track by day.key"
                        ) {{ day.label }}

                    .gantt-timeline-grid(
                        ng-style="ctrl.timeline.gridStyle"
                    )
                        .gantt-bars-layer
                            svg.gantt-bars-svg(
                                ng-style="ctrl.timeline.svgStyle"
                                ng-attr-viewBox="0 0 {{ctrl.timeline.totalDays}} {{ctrl.timeline.rowCount}}"
                                ng-attr-data-total-days="{{ctrl.timeline.totalDays}}"
                                preserveAspectRatio="none"
                            )
                                g(ng-repeat="bar in ctrl.ganttBars track by bar.rowId")
                                    rect.gantt-bar(
                                        ng-if="bar.shape == 'rounded'"
                                        class="gantt-bar-{{bar.barType}}"
                                        ng-attr-data-gantt-row-id="{{bar.rowId}}"
                                        ng-attr-data-bar-type="{{bar.barType}}"
                                        ng-attr-data-shape="{{bar.shape}}"
                                        ng-attr-data-start-day="{{bar.startDay}}"
                                        ng-attr-data-end-day="{{bar.endDay}}"
                                        ng-attr-x="{{bar.rect.x}}"
                                        ng-attr-y="{{bar.rect.y}}"
                                        ng-attr-width="{{bar.rect.width}}"
                                        ng-attr-height="{{bar.rect.height}}"
                                        ng-attr-rx="{{bar.rect.rx}}"
                                        ng-attr-ry="{{bar.rect.ry}}"
                                    )
                                        title {{ bar.label }}

                                    path.gantt-bar(
                                        ng-if="bar.shape != 'rounded'"
                                        class="gantt-bar-{{bar.barType}}"
                                        ng-attr-data-gantt-row-id="{{bar.rowId}}"
                                        ng-attr-data-bar-type="{{bar.barType}}"
                                        ng-attr-data-shape="{{bar.shape}}"
                                        ng-attr-data-start-day="{{bar.startDay}}"
                                        ng-attr-data-end-day="{{bar.endDay}}"
                                        shape-rendering="crispEdges"
                                        ng-attr-d="{{bar.pathD}}"
                                    )
                                        title {{ bar.label }}
