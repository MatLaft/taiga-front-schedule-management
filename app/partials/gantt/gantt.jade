            .gantt-panel-resizer(
                role="separator"
                aria-orientation="vertical"
                aria-label="Resize gantt panels"
                tabindex="0"
            )

            section.gantt-right-panel
                - var timelineMonths = [{label: "Apr 2026", days: 30}, {label: "May 2026", days: 31}]
                - var totalDays = timelineMonths.reduce(function(sum, month) { return sum + month.days; }, 0)
                - var dayWidthRem = 2.2
                - var timelineWidth = (totalDays * dayWidthRem) + "rem"
                - var rowCount = 10
                - var ganttBars = [{type: "epic", shape: "arrow", label: "Epic: Platform Migration", rowId: "epic-1", row: 0, start: 1, end: 28}, {type: "story", shape: "arrow", label: "Story: Account settings redesign", rowId: "story-1-1", row: 1, start: 8, end: 14}, {type: "task", shape: "rounded", label: "Task: Create wireframes", rowId: "task-1-1-1", row: 2, start: 8, end: 9}, {type: "task", shape: "rounded", label: "Task: API contract review", rowId: "task-1-1-2", row: 3, start: 9, end: 10}, {type: "story", shape: "arrow", label: "Story: Notification preferences", rowId: "story-1-2", row: 4, start: 10, end: 18}, {type: "task", shape: "rounded", label: "Task: QA smoke tests", rowId: "task-1-2-1", row: 5, start: 11, end: 12}, {type: "task", shape: "rounded", label: "Task: Copy review", rowId: "task-1-2-2", row: 6, start: 12, end: 13}, {type: "epic", shape: "arrow", label: "Epic: New Billing Flow", rowId: "epic-2", row: 7, start: 5, end: 26}, {type: "story", shape: "arrow", label: "Story: Team permissions cleanup", rowId: "story-2-1", row: 8, start: 12, end: 20}, {type: "task", shape: "rounded", label: "Task: Accessibility pass", rowId: "task-2-1-1", row: 9, start: 14, end: 16}]
                - var ganttArrowPath = function(startDay, endDay, rowIndex) { var left = Math.max(0, startDay - 1); var right = Math.min(totalDays, endDay); var top = rowIndex + 0.22; var bottom = rowIndex + 0.58; var tip = rowIndex + 0.74; var inset = 0.28; return "M" + left + "," + top + "L" + right + "," + top + "L" + right + "," + bottom + "L" + right + "," + tip + "L" + (right - inset) + "," + bottom + "L" + (left + inset) + "," + bottom + "L" + left + "," + tip + "L" + left + "," + bottom + "z"; }
                - var ganttStoryPath = function(startDay, endDay, rowIndex) { var left = Math.max(0, startDay - 1); var right = Math.min(totalDays, endDay); var top = rowIndex + 0.22; var bottom = rowIndex + 0.58; var mid = (top + bottom) / 2; var span = Math.max(right - left, 0.5); var notch = Math.min(0.28, span / 4); return "M" + left + "," + top + "L" + right + "," + top + "L" + (right - notch) + "," + mid + "L" + right + "," + bottom + "L" + left + "," + bottom + "L" + (left + notch) + "," + mid + "z"; }

                .gantt-timeline
                    .gantt-timeline-months
                        each month in timelineMonths
                            - var monthWidth = (month.days * dayWidthRem) + "rem"
                            .gantt-month(style="width:" + monthWidth) #{month.label}

                    - var dayColumns = "repeat(" + totalDays + ", " + dayWidthRem + "rem)"
                    .gantt-timeline-days(style="grid-template-columns:" + dayColumns)
                        each month in timelineMonths
                            - var monthDays = Array.apply(null, Array(month.days))
                            each _, index in monthDays
                                .gantt-day #{index + 1}

                    .gantt-timeline-grid(style="width:" + timelineWidth)
                        .gantt-bars-layer
                            svg.gantt-bars-svg(
                                style="width:" + timelineWidth + ";height:100%"
                                viewBox="0 0 #{totalDays} #{rowCount}"
                                data-total-days=totalDays
                                preserveAspectRatio="none"
                            )
                                each bar in ganttBars
                                    if bar.shape == "rounded"
                                        rect.gantt-bar(
                                            class="gantt-bar-#{bar.type}"
                                            data-gantt-row-id=bar.rowId
                                            data-bar-type=bar.type
                                            data-shape=bar.shape
                                            data-start-day=bar.start
                                            data-end-day=bar.end
                                            x=bar.start - 1
                                            y=bar.row + 0.28
                                            width=bar.end - bar.start + 1
                                            height=0.32
                                            rx=0.16
                                            ry=0.16
                                        )
                                            title= bar.label
                                    else
                                        - var barPath = bar.type == "story" ? ganttStoryPath(bar.start, bar.end, bar.row) : ganttArrowPath(bar.start, bar.end, bar.row)
                                        path.gantt-bar(
                                            class="gantt-bar-#{bar.type}"
                                            data-gantt-row-id=bar.rowId
                                            data-bar-type=bar.type
                                            data-shape=bar.shape
                                            data-start-day=bar.start
                                            data-end-day=bar.end
                                            shape-rendering="crispEdges"
                                            d=barPath
                                        )
                                            title= bar.label
